/E (void loop\(\) {  int switchState = digitalRead\(pushSwitch\);  if \(switchState == LOW\) {   // Switch pressed  // Red + buzzer ON  digitalWrite\(rgbRed, HIGH\);  digitalWrite\(rgbGreen, LOW\);  digitalWrite\(rgbBlue, LOW\);  digitalWrite\(buzzer, HIGH\);  delay\(500\); })
/Pg 23 0 R
/K [9 8]
>>
