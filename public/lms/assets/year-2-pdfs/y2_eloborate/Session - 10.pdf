/T ( if \(digitalRead\(touchSensor\) == TOUCH_ACTIVE\) {  emergencyAlarm\(\);  } else if \(soundValue > noiseLimit\) {  digitalWrite\(buzzer, HIGH\);  delay\(100\);  digitalWrite\(buzzer, LOW\);  delay\(100\);  } else {  digitalWrite\(buzzer, LOW\);  }  }  void emergencyAlarm\(\) {  for \(int i = 0; i < 5; i++\) {  digitalWrite\(buzzer, HIGH\);  delay\(150\);  digitalWrite\(buzzer, LOW\);  delay\(150\);  }  })
/E ( if \(digitalRead\(touchSensor\) == TOUCH_ACTIVE\) {  emergencyAlarm\(\);  } else if \(soundValue > noiseLimit\) {  digitalWrite\(buzzer, HIGH\);  delay\(100\);  digitalWrite\(buzzer, LOW\);  delay\(100\);  } else {  digitalWrite\(buzzer, LOW\);  }  }  void emergencyAlarm\(\) {  for \(int i = 0; i < 5; i++\) {  digitalWrite\(buzzer, HIGH\);  delay\(150\);  digitalWrite\(buzzer, LOW\);  delay\(150\);  }  })
/Pg 32 0 R
/K [2]
