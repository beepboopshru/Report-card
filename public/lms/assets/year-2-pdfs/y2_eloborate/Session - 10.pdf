/P 142 0 R
/T ( void setup\(\) {  pinMode\(irSensor, INPUT\);  pinMode\(led, OUTPUT\);  display.setBrightness\(7\);  display.showNumberDec\(0, true\);  }  void loop\(\) {  int ldrValue = analogRead\(ldrSensor\);  if \(ldrValue > darkValue\) {  digitalWrite\(led, HIGH\); // night light ON  } else {  digitalWrite\(led, LOW\); // enough light, LED OFF  }  bool currentIR = digitalRead\(irSensor\);  if \(currentIR == IR_DETECTED && lastIR != IR_DETECTED\) {  personCount++;  if \(personCount > 9999\) personCount = 0;  display.showNumberDec\(personCount, true\);  delay\(300\);  }  lastIR = currentIR;  })
/E ( void setup\(\) {  pinMode\(irSensor, INPUT\);  pinMode\(led, OUTPUT\);  display.setBrightness\(7\);  display.showNumberDec\(0, true\);  }  void loop\(\) {  int ldrValue = analogRead\(ldrSensor\);  if \(ldrValue > darkValue\) {  digitalWrite\(led, HIGH\); // night light ON  } else {  digitalWrite\(led, LOW\); // enough light, LED OFF  }  bool currentIR = digitalRead\(irSensor\);  if \(currentIR == IR_DETECTED && lastIR != IR_DETECTED\) {  personCount++;  if \(personCount > 9999\) personCount = 0;  display.showNumberDec\(personCount, true\);  delay\(300\);  }  lastIR = currentIR;  })
/Pg 20 0 R
/K [2]
>>
endobj
